ELASTICSEARCH_URL=https://localhost:9200

# Auth: prefer API key. If API key is empty, use username/password.
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme

ELASTICSEARCH_INDEX_PATTERN=logs-*
ELASTICSEARCH_VERIFY_CERTS=false
ELASTICSEARCH_CA_CERTS=

# Optional field mapping overrides. If set, these skip auto-discovery.
# FIELD_TIMESTAMP=@timestamp
# FIELD_MESSAGE=message
# FIELD_LEVEL=log.level
# FIELD_SERVICE=service.name
# FIELD_CORRELATION=trace.id
# FIELD_HOSTNAME=host.hostname

# Optional test
EXTRA_MESSAGE_CANDIDATES=evento
EXTRA_SERVICE_CANDIDATES=fields.app
EXTRA_CORRELATION_CANDIDATES=fields.ets_correlationid
EXTRA_MESSAGE_FALLBACKS=evento

# Optional extra discovery candidates, checked before defaults. Comma-separated.
# EXTRA_TIMESTAMP_CANDIDATES=
# EXTRA_MESSAGE_CANDIDATES=
# EXTRA_LEVEL_CANDIDATES=
# EXTRA_SERVICE_CANDIDATES=
# EXTRA_CORRELATION_CANDIDATES=
# EXTRA_HOSTNAME_CANDIDATES=
# EXTRA_MESSAGE_FALLBACKS=

# MCP network transport settings for Docker
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8091
